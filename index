<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Minha História em Quadrinhos</title>
  <style>
    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    body {
      background-color: #f4e8c1;
      background-image: radial-gradient(#d8c89e 1px, transparent 1px);
      background-size: 20px 20px;
      font-family: 'Comic Sans MS', 'Chalkboard SE', 'Comic Neue', sans-serif;
      color: #111;
      padding: 20px 10px;
    }

    header {
      text-align: center;
      max-width: 800px;
      margin: 0 auto 30px auto;
      background: #ffde00;
      border: 4px solid #000;
      box-shadow: 6px 6px 0px #000;
      padding: 15px;
      transform: rotate(-1deg);
    }

    header h1 {
      font-size: 2rem;
      text-transform: uppercase;
      letter-spacing: 2px;
      text-shadow: 2px 2px 0px #fff;
    }

    .hq-container {
      max-width: 750px;
      margin: 0 auto;
      display: flex;
      flex-direction: column;
      gap: 35px;
    }

    .quadro {
      position: relative;
      background: #fff;
      border: 5px solid #000;
      box-shadow: 8px 8px 0px #000;
      overflow: hidden;
    }

    .numero-cena {
      position: absolute;
      top: 0;
      left: 0;
      background: #ffde00;
      border-right: 4px solid #000;
      border-bottom: 4px solid #000;
      padding: 4px 12px;
      font-weight: bold;
      font-size: 1.1rem;
      z-index: 10;
    }

    .quadro img {
      width: 100%;
      height: auto;
      display: block;
      min-height: 250px;
      background-color: #e0e0e0;
      object-fit: cover;
    }

    /* Estilo dos Balões de Diálogo */
    .balao {
      position: absolute;
      background: #fff;
      border: 3px solid #000;
      border-radius: 25px;
      padding: 12px 16px;
      max-width: 65%;
      font-size: 0.95rem;
      font-weight: bold;
      line-height: 1.3;
      box-shadow: 3px 3px 0px rgba(0, 0, 0, 0.8);
      z-index: 5;
    }

    /* Rabicho (seta) do balão */
    .balao::after {
      content: '';
      position: absolute;
      bottom: -14px;
      left: 25px;
      border-width: 14px 12px 0;
      border-style: solid;
      border-color: #000 transparent;
      display: block;
      width: 0;
    }

    .balao::before {
      content: '';
      position: absolute;
      bottom: -9px;
      left: 28px;
      border-width: 10px 9px 0;
      border-style: solid;
      border-color: #fff transparent;
      display: block;
      width: 0;
      z-index: 6;
    }

    /* Variações de posição dos balões para cada cena */
    .pos-topo-esq { top: 45px; left: 15px; }
    .pos-topo-dir { top: 20px; right: 15px; }
    .pos-topo-dir::after { left: auto; right: 25px; }
    .pos-topo-dir::before { left: auto; right: 28px; }
    
    .pos-baixo-esq { bottom: 65px; left: 15px; }
    .pos-baixo-dir { bottom: 65px; right: 15px; }
    .pos-baixo-dir::after { left: auto; right: 25px; }
    .pos-baixo-dir::before { left: auto; right: 28px; }

    /* Caixa de narração (retangular, sem rabicho) */
    .narracao {
      position: absolute;
      top: 15px;
      right: 15px;
      background: #ffde00;
      border: 3px solid #000;
      padding: 8px 12px;
      max-width: 60%;
      font-size: 0.9rem;
      font-style: italic;
      font-weight: bold;
      box-shadow: 3px 3px 0px #000;
      z-index: 5;
    }

    /* Botão Ouvir */
    .btn-ouvir {
      position: absolute;
      bottom: 12px;
      right: 12px;
      background: #ff3b30;
      color: #fff;
      border: 3px solid #000;
      padding: 8px 14px;
      font-family: inherit;
      font-weight: bold;
      font-size: 0.95rem;
      cursor: pointer;
      box-shadow: 3px 3px 0px #000;
      z-index: 15;
      transition: transform 0.1s, background 0.2s;
    }

    .btn-ouvir:hover {
      background: #e02e24;
    }

    .btn-ouvir:active {
      transform: translate(2px, 2px);
      box-shadow: 1px 1px 0px #000;
    }

    .btn-ouvir.falando {
      background: #34c759;
      color: #000;
    }

    /* Ajustes para telas de celular */
    @media (max-width: 600px) {
      header h1 {
        font-size: 1.5rem;
      }

      .balao, .narracao {
        max-width: 82%;
        font-size: 0.85rem;
        padding: 8px 12px;
      }

      .pos-topo-esq { top: 40px; left: 10px; }
      .pos-topo-dir { top: 40px; right: 10px; }
      .pos-baixo-esq { bottom: 55px; left: 10px; }
      .pos-baixo-dir { bottom: 55px; right: 10px; }

      .btn-ouvir {
        padding: 6px 10px;
        font-size: 0.85rem;
      }
    }
  </style>
</head>
<body>

  <header>
    <h1>Título da Minha HQ</h1>
  </header>

  <main class="hq-container">

    <!-- CENA 1 -->
    <article class="quadro">
      <span class="numero-cena">1</span>
      <img src="imagens/cena1.png" alt="Cena 1 da história em quadrinhos">
      
      <div class="narracao">Tudo começou em uma manhã aparentemente comum...</div>
      <div class="balao pos-topo-esq">Ei! Você está vendo aquilo ali no céu?</div>
      
      <button class="btn-ouvir" data-dialogo="Tudo começou em uma manhã aparentemente comum. Ei! Você está vendo aquilo ali no céu?">
        🔊 Ouvir
      </button>
    </article>

    <!-- CENA 2 -->
    <article class="quadro">
      <span class="numero-cena">2</span>
      <img src="imagens/cena2.png" alt="Cena 2 da história em quadrinhos">
      
      <div class="balao pos-topo-dir">Não pode ser! Isso não estava previsto no mapa!</div>
      
      <button class="btn-ouvir" data-dialogo="Não pode ser! Isso não estava previsto no mapa!">
        🔊 Ouvir
      </button>
    </article>

    <!-- CENA 3 -->
    <article class="quadro">
      <span class="numero-cena">3</span>
      <img src="imagens/cena3.png" alt="Cena 3 da história em quadrinhos">
      
      <div class="balao pos-topo-esq">Precisamos agir rápido antes que seja tarde demais!</div>
      <div class="balao pos-baixo-dir">Estou bem atrás de você, vamos lá!</div>
      
      <button class="btn-ouvir" data-dialogo="Precisamos agir rápido antes que seja tarde demais! Estou bem atrás de você, vamos lá!">
        🔊 Ouvir
      </button>
    </article>

    <!-- CENA 4 -->
    <article class="quadro">
      <span class="numero-cena">4</span>
      <img src="imagens/cena4.png" alt="Cena 4 da história em quadrinhos">
      
      <div class="balao pos-topo-dir">Conseguimos! O sistema voltou a funcionar perfeitamente!</div>
      
      <button class="btn-ouvir" data-dialogo="Conseguimos! O sistema voltou a funcionar perfeitamente!">
        🔊 Ouvir
      </button>
    </article>

    <!-- CENA 5 -->
    <article class="quadro">
      <span class="numero-cena">5</span>
      <img src="imagens/cena5.png" alt="Cena 5 da história em quadrinhos">
      
      <div class="narracao">E assim, a paz voltou a reinar... pelo menos por hoje.</div>
      <div class="balao pos-baixo-esq">Nada como um final feliz. Até a próxima aventura!</div>
      
      <button class="btn-ouvir" data-dialogo="E assim, a paz voltou a reinar, pelo menos por hoje. Nada como um final feliz. Até a próxima aventura!">
        🔊 Ouvir
      </button>
    </article>

  </main>

  <script>
    const botoesOuvir = document.querySelectorAll('.btn-ouvir');

    botoesOuvir.forEach(botao => {
      botao.addEventListener('click', () => {
        // Verifica se o navegador suporta síntese de voz
        if (!('speechSynthesis' in window)) {
          alert('Desculpe, seu navegador não suporta a leitura de áudio.');
          return;
        }

        // Se já estiver falando, interrompe o áudio atual
        if (window.speechSynthesis.speaking) {
          const estavaFalandoEste = botao.classList.contains('falando');
          window.speechSynthesis.cancel();
          resetarBotoes();
          if (estavaFalandoEste) return;
        }

        const texto = botao.getAttribute('data-dialogo');
        const fala = new SpeechSynthesisUtterance(texto);
        
        // Configura o idioma para Português do Brasil
        fala.lang = 'pt-BR';
        fala.rate = 1.0; // Velocidade da fala
        fala.pitch = 1.0; // Tom da voz

        // Atualiza o visual do botão enquanto fala
        fala.onstart = () => {
          resetarBotoes();
          botao.classList.add('falando');
          botao.innerHTML = '⏹ Parar';
        };

        // Restaura o botão ao terminar
        fala.onend = () => {
          resetarBotoes();
        };

        fala.onerror = () => {
          resetarBotoes();
        };

        window.speechSynthesis.speak(fala);
      });
    });

    function resetarBotoes() {
      botoesOuvir.forEach(btn => {
        btn.classList.remove('falando');
        btn.innerHTML = '🔊 Ouvir';
      });
    }
  </script>

</body>
</html>
